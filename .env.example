# ==========================================
# JARVIS DUAL-DEVICE ASSISTANT ENVIRONMENT CONFIG
# ==========================================

# 1. Google Gemini AI Engine
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Remote Windows Companion Device (SSH Bridge)
LAPTOP_IP=192.168.1.x
LAPTOP_USER=jarvis
LAPTOP_PASSWORD=your_remote_ssh_password
MAIN_WINDOWS_USER=your_windows_username

# 3. Audio & Neural Speech
EDGE_TTS_VOICE=en-GB-RyanNeural
EDGE_TTS_RATE=-5%
EDGE_TTS_PITCH=-12Hz

# 4. Smart Home MirAIe Integration (Optional)
MIRAIE_USER=your_miraie_user
MIRAIE_PASSWORD=your_miraie_pass

# 5. Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# 6. HUD Server Port
HUD_PORT=5000
